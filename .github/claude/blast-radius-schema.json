{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "dangers", "summary", "findings", "next_steps", "untraced", "not_planned_roots"],
  "properties": {
    "verdict": { "type": "string", "enum": ["low", "medium", "high"] },
    "dangers": {
      "type": "array",
      "description": "What goes wrong if this merges and is applied, most severe first. One plain sentence each.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "text"],
        "properties": {
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "text": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "action", "risk", "why", "impacts"],
        "properties": {
          "resource": { "type": "string" },
          "action": { "type": "string" },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "why": { "type": "string" },
          "impacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["affected", "how", "evidence"],
              "properties": {
                "affected": { "type": "string" },
                "how": { "type": "string" },
                "evidence": {
                  "type": "array",
                  "description": "One path:line (or path:start-end) per entry, each a line you read",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "description": "Suggested actions for the PR author, in order. One sentence each.",
      "items": { "type": "string" }
    },
    "untraced": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "reason"],
        "properties": {
          "item": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "not_planned_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root", "reason"],
        "properties": {
          "root": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
